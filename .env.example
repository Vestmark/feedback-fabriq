PORT=3001

# "dev" = no login, mock user (refused when NODE_ENV=production). "okta" = validate Okta bearer tokens.
AUTH_MODE=dev
OKTA_ISSUER=https://vestmark.okta.com
OKTA_CLIENT_ID=
# Comma-separated emails allowed into /admin.html (in dev mode the mock user is admin)
ADMIN_EMAILS=
DEV_USER_EMAIL=dev@vestmark.com

# "bedrock" or "mock" (canned replies, no AWS needed)
CHAT_MODE=mock
AWS_REGION=us-east-1
AWS_PROFILE=claude-code
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Only if a TLS-inspecting proxy (Zscaler) reissues the Bedrock cert: absolute path to its root CA PEM
# NODE_EXTRA_CA_CERTS=/absolute/path/to/zscaler-root.pem

# Email notification on submit (optional; outcome is recorded per item either way)
RESEND_API_KEY=
MAIL_FROM=feedback@example.com
FEEDBACK_RECIPIENT=

DB_PATH=./data/feedback.db
